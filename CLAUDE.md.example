## 🔧 Часто используемые паттерны

### Валидация входных данных

```python
def validate_input(data: dict[str, Any]) -> dict[str, Any]:
    """Validate and sanitize input data.

    Args:
        data: Raw input data

    Returns:
        Validated data

    Raises:
        ValueError: If validation fails
    """
    required_fields = ["field1", "field2"]
    for field in required_fields:
        if field not in data:
            raise ValueError(f"Missing required field: {field}")

    # Type validation
    if not isinstance(data["field1"], str):
        raise TypeError(f"field1 must be str, got {type(data['field1'])}")

    return data
```

### Работа с файлами

```python
from pathlib import Path

def read_config(config_path: str | Path) -> dict[str, Any]:
    """Read configuration from file.

    Args:
        config_path: Path to config file

    Returns:
        Configuration dictionary

    Raises:
        FileNotFoundError: If file doesn't exist
        ValueError: If file format is invalid
    """
    path = Path(config_path)
    if not path.exists():
        raise FileNotFoundError(f"Config not found: {path}")

    with path.open("r", encoding="utf-8") as f:
        return json.load(f)
```

### Обработка ошибок API/внешних сервисов

```python
import httpx
from tenacity import retry, stop_after_attempt, wait_exponential

@retry(
    stop=stop_after_attempt(3),
    wait=wait_exponential(multiplier=1, min=2, max=10)
)
async def fetch_external_data(url: str) -> dict[str, Any]:
    """Fetch data from external API with retries.

    Args:
        url: API endpoint URL

    Returns:
        Response data

    Raises:
        httpx.HTTPError: On network/HTTP errors after retries
    """
    async with httpx.AsyncClient(timeout=10.0) as client:
        response = await client.get(url)
        response.raise_for_status()
        return response.json()
```

